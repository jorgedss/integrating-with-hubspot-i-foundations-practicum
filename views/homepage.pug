doctype html
html
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    title= title
    link(rel='stylesheet' href='/css/style.css')
  body
    h1 Pets Registry
    table
      thead
        tr
          th Name
          th Species
          th Bio
      tbody
        each pet in data
          tr
            td= pet.properties.name || 'N/A'
            td= pet.properties.species || 'N/A'
            td= pet.properties.bio || 'N/A'
    br
    a(href='/update-cobj') Add a New Pet to This Table
